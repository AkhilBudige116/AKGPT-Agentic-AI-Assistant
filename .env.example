# Copy this file to .env and add your own keys. Never commit .env.

# Required for chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b

# Optional integrations
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
WEATHER_UNITS=metric
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AKGPT

# Local storage
DATABASE_URL=sqlite:///./data/akgpt.db
CHECKPOINT_DB_PATH=./data/langgraph_checkpoints.sqlite
FAISS_INDEX_PATH=./faiss_db
UPLOAD_DIR=./uploads

# Server
HOST=127.0.0.1
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
